---
export interface Props {
	title: string;
	description?: string;
}

const { title, description = "Recupere al ser amado ya! Consultas espirituales y amarres de amor con más de cuatro décadas de experiencia." } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@300;400;700&family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
		
		<style>
			/* Reset y Base */
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}
			
			html {
				scroll-behavior: smooth;
			}
			
			body {
				font-family: 'Open Sans', sans-serif;
				line-height: 1.6;
				color: #333;
				background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
				min-height: 100vh;
			}
			
			/* Tipografía */
			h1, h2, h3, h4, h5, h6 {
				font-family: 'Merriweather', serif;
				font-weight: 700;
				line-height: 1.3;
				margin-bottom: 1rem;
			}
			
			h1 { font-size: 2.5rem; color: #f4a261; }
			h2 { font-size: 2rem; color: #e76f51; }
			h3 { font-size: 1.5rem; color: #f4a261; }
			h4 { font-size: 1.25rem; color: #e76f51; }
			h5 { font-size: 1.1rem; color: #f4a261; }
			h6 { font-size: 1rem; color: #e76f51; }
			
			p {
				margin-bottom: 1rem;
				color: #e9ecef;
			}
			
			/* Layout Principal */
			.container {
				max-width: 800px;
				margin: 0 auto;
				padding: 0 1rem;
			}
			
			/* Header */
			.header {
				background: rgba(0, 0, 0, 0.8);
				padding: 1rem 0;
				position: sticky;
				top: 0;
				z-index: 100;
				backdrop-filter: blur(10px);
			}
			
			.nav {
				display: flex;
				justify-content: center;
				align-items: center;
			}
			
			.nav a {
				color: #f4a261;
				text-decoration: none;
				font-weight: 600;
				font-size: 1.1rem;
				padding: 0.5rem 1rem;
				border-radius: 5px;
				transition: all 0.3s ease;
			}
			
			.nav a:hover {
				background: rgba(244, 162, 97, 0.1);
				transform: translateY(-2px);
			}
			
			/* Botones de Llamada */
			.call-button {
				display: inline-block;
				background: linear-gradient(45deg, #e76f51, #f4a261);
				color: white;
				text-decoration: none;
				padding: 1rem 2rem;
				border-radius: 25px;
				font-weight: 700;
				font-size: 1.1rem;
				text-align: center;
				transition: all 0.3s ease;
				box-shadow: 0 4px 15px rgba(231, 111, 81, 0.3);
				margin: 1rem 0;
			}
			
			.call-button:hover {
				transform: translateY(-3px);
				box-shadow: 0 6px 20px rgba(231, 111, 81, 0.4);
			}
			
			/* Botón Flotante */
			.floating-call {
				position: fixed;
				bottom: 20px;
				right: 20px;
				background: linear-gradient(45deg, #e76f51, #f4a261);
				color: white;
				text-decoration: none;
				padding: 1rem;
				border-radius: 50%;
				width: 60px;
				height: 60px;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 1.5rem;
				box-shadow: 0 4px 20px rgba(231, 111, 81, 0.4);
				z-index: 1000;
				transition: all 0.3s ease;
			}
			
			.floating-call:hover {
				transform: scale(1.1);
			}
			
			/* Secciones */
			.section {
				padding: 3rem 0;
				text-align: center;
			}
			
			.section-dark {
				background: rgba(0, 0, 0, 0.3);
			}
			
			/* Imágenes */
			.feature-image {
				width: 100%;
				max-width: 400px;
				height: auto;
				border-radius: 10px;
				margin: 2rem auto;
				display: block;
				box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
			}
			
			/* Testimonios */
			.testimonial-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 2rem;
				margin: 2rem 0;
			}
			
			.testimonial-card {
				background: rgba(255, 255, 255, 0.1);
				padding: 1.5rem;
				border-radius: 10px;
				text-align: left;
			}
			
			/* Footer */
			.footer {
				background: rgba(0, 0, 0, 0.8);
				padding: 2rem 0;
				text-align: center;
				color: #e9ecef;
				margin-top: 3rem;
			}
			
			/* Responsive */
			@media (max-width: 768px) {
				.container {
					padding: 0 0.5rem;
				}
				
				h1 { font-size: 2rem; }
				h2 { font-size: 1.5rem; }
				h3 { font-size: 1.25rem; }
				
				.call-button {
					padding: 0.8rem 1.5rem;
					font-size: 1rem;
				}
				
				.floating-call {
					width: 50px;
					height: 50px;
					font-size: 1.2rem;
				}
			}
		</style>
	</head>
	<body>
		<header class="header">
			<nav class="nav container">
				<a href="#inicio">HOME</a>
			</nav>
		</header>
		
		<main>
			<slot />
		</main>
		
		<a href="tel:+12138143588" class="floating-call" title="Llamar Ahora">
			📞
		</a>
		
		<footer class="footer">
			<div class="container">
				<p>&copy; 2024 Amores Ligados | Powered by</p>
				<button onclick="scrollToTop()" class="call-button" style="margin-top: 1rem;">
					Scroll al inicio
				</button>
			</div>
		</footer>
		
		<script>
			function scrollToTop() {
				window.scrollTo({ top: 0, behavior: 'smooth' });
			}
		</script>
	</body>
</html>